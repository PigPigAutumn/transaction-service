            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="查询参数处理器" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonOutput

// 获取变量值
def account = vars.get(&quot;account&quot;)
def lastCreateTime = vars.get(&quot;lastCreateTime&quot;)
def lastIdStr = vars.get(&quot;lastId&quot;) // 获取字符串形式的 lastId

// 构建基础请求体
def requestBody = [
    &quot;account&quot;: account,
    &quot;pageSize&quot;: 50
]

// 只有当 lastCreateTime 和 lastId 都有有效值时才添加 cursor
if (lastCreateTime != null &amp;&amp; !lastCreateTime.isEmpty() &amp;&amp; 
    lastIdStr != null &amp;&amp; lastIdStr != &quot;0&quot;) {
    
    // 将 lastId 转换为 Long 类型，避免 Integer 溢出
    try {
        def lastIdLong = Long.parseLong(lastIdStr)
        requestBody.cursor = [
            &quot;lastCreateTime&quot;: lastCreateTime,
            &quot;lastId&quot;: lastIdLong  // 使用 Long 类型
        ]
    } catch (NumberFormatException e) {
        // 如果转换失败，使用字符串形式（如果API支持）
        log.warn(&quot;lastId 转换失败，使用字符串形式: &quot; + lastIdStr)
        requestBody.cursor = [
            &quot;lastCreateTime&quot;: lastCreateTime,
            &quot;lastId&quot;: lastIdStr  // 保持字符串形式
        ]
    }
} else {
    // 如果没有有效的游标值，可以完全省略 cursor 字段
    // 或者设置为 null，取决于您的 API 设计
    requestBody.cursor = null
}

// 将请求体转换为 JSON 字符串
def jsonBody = JsonOutput.toJson(requestBody)
vars.put(&quot;requestBody&quot;, jsonBody)

log.info(&quot;构建的请求体: &quot; + jsonBody)</stringProp>
            </JSR223PreProcessor>
