          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="生成随机参数" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.util.Random

// 生成随机交易类型
def types = [&quot;TRANSFER&quot;, &quot;DEPOSIT&quot;, &quot;WITHDRAW&quot;, &quot;PAYMENT&quot;]
def randomType = types[new Random().nextInt(types.size())]

// 生成随机状态
def statuses = [&quot;SUCCESS&quot;, &quot;FAILED&quot;, &quot;PROCESSING&quot;]
def randomStatus = statuses[new Random().nextInt(statuses.size())]

// 生成随机金额和余额
def amount = new Random().nextInt(20000) - 10000 // -10000 到 10000
def balance = new Random().nextInt(1000000) // 0 到 1000000

// 生成随机对手方
def counterparty = &quot;counterparty_&quot; + (new Random().nextInt(100) + 1)

// 构建请求体 JSON
def requestBody = &quot;&quot;&quot;
{
  &quot;transactionId&quot;: &quot;${vars.get(&quot;transactionId&quot;)}&quot;,
  &quot;account&quot;: &quot;${vars.get(&quot;account&quot;)}&quot;,
  &quot;amount&quot;: ${amount},
  &quot;balance&quot;: ${balance},
  &quot;type&quot;: &quot;${randomType}&quot;,
  &quot;status&quot;: &quot;${randomStatus}&quot;,
  &quot;counterparty&quot;: &quot;${counterparty}&quot;,
  &quot;description&quot;: &quot;Stress Testing&quot;
}
&quot;&quot;&quot;

// 将请求体存储为变量
vars.put(&quot;requestBody&quot;, requestBody)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
